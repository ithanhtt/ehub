# Copy to .env.local, or just run `npm run dev` — it generates the file with
# fresh secrets on first start.

# --- Database ---------------------------------------------------------------
# Empty  -> embedded PGlite in ./.data/pgdata (development default, no setup).
# Set it -> any real Postgres. Same schema, same migrations, no code change.
#   DATABASE_URL=postgresql://user:password@host:5432/adshub
DATABASE_URL=
DATABASE_POOL_MAX=10

# Override where the embedded database keeps its files.
# PGLITE_DATA_DIR=

# --- Auth -------------------------------------------------------------------
# Signs session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=
# Public origin of the app. Must match the browser address in production.
BETTER_AUTH_URL=http://localhost:3000
# Extra origins allowed to call the auth API, comma separated.
TRUSTED_ORIGINS=

# --- Credential encryption --------------------------------------------------
# AES-256-GCM key protecting stored connector credentials (TikTok tokens, Sapo
# keys). 32 bytes, base64 or hex.
#
# WARNING: changing this makes every credential already in the database
# unreadable. Rotating it means re-entering every connection's credentials.
APP_ENCRYPTION_KEY=

# --- Background sync --------------------------------------------------------
# Keeps the dashboard's Sapo data in sync on the server even when nobody has it
# open. Empty -> on in production (`next start`), off under `npm run dev` (a
# development machine would share the store's API budget with the server).
# SAPO_BACKGROUND_SYNC=1 or =0 forces it either way.
SAPO_BACKGROUND_SYNC=

# Fills in the booking data's results (orders, revenue per booked video) from
# TikTok Shop every five minutes, dev included. Empty -> on; =0 turns it off.
BOOKING_AUTO_SYNC=

# In-app updates (user menu → System update, Administrators only).
# The same key on both machines — make one with: openssl rand -base64 32
UPDATE_SIGNING_KEY=
# On the development machine: the server to send updates to (https://…).
UPDATE_SERVER_URL=
# On the server: accept updates (deploy/install.sh sets this).
UPDATE_RECEIVER=
